//+------------------------------------------------------------------+
//| Expert Initialization Function                                   |
//+------------------------------------------------------------------+
int OnInit()
{
    ObjectsDeleteAll(0, LINE_PREFIX);
    presetModoActual = InpPresetActivo;

    // Calibración inicial de parámetros y Magic Number según activo
    CalibrarParametrosActivo();

    trade.SetExpertMagicNumber(magicEfectivo);
    trade.SetDeviationInPoints(10);
    trade.SetTypeFilling(ORDER_FILLING_FOK);

    // Handles de Indicadores Técnicos
    hSlowEMA = iMA(_Symbol, InpTimeframeRef, 200, 0, MODE_EMA, PRICE_CLOSE);
    hEMA_Chart = iMA(_Symbol, _Period, 50, 0, MODE_EMA, PRICE_CLOSE);
    hATR = iATR(_Symbol, _Period, 14);
    hFractals = iFractals(_Symbol, _Period);

    if (hRSI == INVALID_HANDLE || hSlowEMA == INVALID_HANDLE || hEMA_Chart == INVALID_HANDLE || hFractals == INVALID_HANDLE)
    {
        Print("Error inicializando indicadores en v2.3.");
        return (INIT_FAILED);
    }

    // Dibujar indicadores en subventana y gráfico
    AsegurarIndicadoresEnGrafico();

    AplicarPerfilRiesgo();

    if (InpMostrarHUD)
    {
        RedibujarHUD();
    }

    if (InpMostrarLineasEstructura)
    {
        ActualizarLineasEstructura();
    }

    Print("Bayesian Strategy Pro v2.3 Iniciado Correctamente. Magic: ", magicEfectivo, " Activo: ", txtActivoDetectado);
    return (INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Expert Deinitialization Function                                 |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
    DestruirHUD();
    ObjectsDeleteAll(0, LINE_PREFIX);
    
    if (hRSI != INVALID_HANDLE) IndicatorRelease(hRSI);
    if (hSlowEMA != INVALID_HANDLE) IndicatorRelease(hSlowEMA);
    if (hEMA_Chart != INVALID_HANDLE) IndicatorRelease(hEMA_Chart);
    if (hATR != INVALID_HANDLE) IndicatorRelease(hATR);
    if (hFractals != INVALID_HANDLE) IndicatorRelease(hFractals);
}

//+------------------------------------------------------------------+
//| Auto-Calibración de Presets & Magic Number por Activo           |
//+------------------------------------------------------------------+
void CalibrarParametrosActivo()
{
    string sym = _Symbol;
    StringToUpper(sym);

    int prevRSIPeriod = rsiPeriodEfectivo;

    // 1. PRESET BITCOIN (BTCUSD) - OPERATIVA 100% 24/7 (01:00 - 23:00 LUNES A DOMINGO)
    if (presetModoActual == PRESET_FORZAR_BTC || (presetModoActual == PRESET_AUTO && StringFind(sym, "BTC") >= 0))
    {
        rsiPeriodEfectivo = InpBtcRsiPeriodo;             // Default 9
        rsiOverboughtEfectivo = InpBtcRsiOverbought;      // Default 65.0
        rsiOversoldEfectivo = InpBtcRsiOversold;        // Default 35.0
        minConfidenceEfectivo = InpBtcMinConfidence;      // Default 70.0%
        distanciaCapasEfectiva = InpBtcDistanciaCapasPts;    // Default 150.0 puntos
        stopLossUSD_Efectivo = 30.0;
        takeProfitUSD_Efectivo = 10.0;
        activarFiltroHorarioEfectivo = InpBtcActivarFiltroHorario;
        horaInicioEfectivo = InpBtcHoraInicio;           // Default 1 (01:00 AM)
        horaFinEfectivo = InpBtcHoraFin;                 // Default 23 (23:00 PM)
        operarLunesEfectivo = InpBtcOperarLunes;
        operarMartesEfectivo = InpBtcOperarMartes;
        operarMiercolesEfectivo = InpBtcOperarMiercoles;
        operarJuevesEfectivo = InpBtcOperarJueves;
        operarViernesEfectivo = InpBtcOperarViernes;
        operarSabadoEfectivo = InpBtcOperarSabado;       // Sábados ON (24/7)
        operarDomingoEfectivo = InpBtcOperarDomingo;      // Domingos ON (24/7)
        magicEfectivo = (InpMagicNumber > 0) ? InpMagicNumber : InpBtcMagicNumber;
        txtActivoDetectado = "BITCOIN (BTCUSD) 24/7" + (presetModoActual == PRESET_FORZAR_BTC ? " [FORZADO ⚙️]" : " [AUTO 🧠]");
    }
    // 2. PRESET ORO (XAUUSD)
    else if (presetModoActual == PRESET_FORZAR_ORO || (presetModoActual == PRESET_AUTO && (StringFind(sym, "XAU") >= 0 || StringFind(sym, "GOLD") >= 0)))
    {
        rsiPeriodEfectivo = InpOroRsiPeriodo;            // Default 14
        rsiOverboughtEfectivo = InpOroRsiOverbought;      // Default 70.0
        rsiOversoldEfectivo = InpOroRsiOversold;        // Default 28.0
        minConfidenceEfectivo = InpOroMinConfidence;      // Default 85.0%
        distanciaCapasEfectiva = InpOroDistanciaCapasPips;     // Default 35.0 pips
        stopLossUSD_Efectivo = 25.0;
        takeProfitUSD_Efectivo = 8.0;
        activarFiltroHorarioEfectivo = InpOroActivarFiltroHorario;
        horaInicioEfectivo = InpOroHoraInicio;
        horaFinEfectivo = InpOroHoraFin;
        operarLunesEfectivo = InpOroOperarLunes;
        operarMartesEfectivo = InpOroOperarMartes;
        operarMiercolesEfectivo = InpOroOperarMiercoles;
        operarJuevesEfectivo = InpOroOperarJueves;
        operarViernesEfectivo = InpOroOperarViernes;
        operarSabadoEfectivo = InpOroOperarSabado;      // Sábados OFF
        operarDomingoEfectivo = InpOroOperarDomingo;     // Domingos OFF
        magicEfectivo = (InpMagicNumber > 0) ? InpMagicNumber : InpOroMagicNumber;
        txtActivoDetectado = "ORO (XAUUSD)" + (presetModoActual == PRESET_FORZAR_ORO ? " [FORZADO ⚙️]" : " [AUTO 🧠]");
    }
    // 3. PRESET FOREX (EURUSD) - Optimizado según Backtest #001
    else if (presetModoActual == PRESET_FORZAR_EURUSD || (presetModoActual == PRESET_AUTO && (StringFind(sym, "EURUSD") >= 0 || StringFind(sym, "GBPUSD") >= 0)))
    {
        rsiPeriodEfectivo = InpEurRsiPeriodo;            // Default 14
        rsiOverboughtEfectivo = InpEurRsiOverbought;      // Default 70.0
        rsiOversoldEfectivo = InpEurRsiOversold;        // Default 30.0
        minConfidenceEfectivo = InpEurMinConfidence;      // Default 80.0%
        distanciaCapasEfectiva = InpEurDistanciaCapasPips;     // Default 25.0 pips
        stopLossUSD_Efectivo = 20.0;
        takeProfitUSD_Efectivo = 8.0;
        activarFiltroHorarioEfectivo = InpEurActivarFiltroHorario;
        horaInicioEfectivo = InpEurHoraInicio;
        horaFinEfectivo = InpEurHoraFin;
        operarLunesEfectivo = InpEurOperarLunes;
        operarMartesEfectivo = InpEurOperarMartes;
        operarMiercolesEfectivo = InpEurOperarMiercoles;
        operarJuevesEfectivo = InpEurOperarJueves;       // Recomendado OFF en EURUSD
        operarViernesEfectivo = InpEurOperarViernes;
        operarSabadoEfectivo = InpEurOperarSabado;      // Sábados OFF
        operarDomingoEfectivo = InpEurOperarDomingo;     // Domingos OFF
        magicEfectivo = (InpMagicNumber > 0) ? InpMagicNumber : InpEurMagicNumber;
        txtActivoDetectado = "FOREX " + sym + (presetModoActual == PRESET_FORZAR_EURUSD ? " [FORZADO ⚙️]" : " [AUTO 🧠]");
    }
    // 4. MODO MANUAL
    else
    {
        rsiPeriodEfectivo = InpRSIPeriod;
        rsiOverboughtEfectivo = InpRSIOverbought;
        rsiOversoldEfectivo = InpRSIOversold;
        minConfidenceEfectivo = InpMinConfidence;
        distanciaCapasEfectiva = InpDistanciaCapasPips;
        stopLossUSD_Efectivo = InpStopLoss_USD;
        takeProfitUSD_Efectivo = InpTakeProfit_USD;
